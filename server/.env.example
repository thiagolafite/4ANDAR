# 4ANDAR API Server — Configuração de Ambiente com Turso
PORT=3001

# =========================================================
# BANCO DE DADOS TURSO (libSQL)
# =========================================================
# Obtenha na sua conta do Turso (https://turso.tech):
# Ex.: turso db show 4andar --url
TURSO_DATABASE_URL=libsql://4andar-seu-usuario.turso.io

# Ex.: turso db tokens create 4andar
TURSO_AUTH_TOKEN=seu_token_jwt_do_turso_aqui

# Se deixar vazio ou não preenchido, o servidor utiliza o arquivo local compatível (data/turso_local.db)

# =========================================================
# E-MAIL SMTP (Lembretes de Mensalidade)
# =========================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=sua-escola@4andar.com.br
SMTP_PASS=sua-senha-de-app-ou-token
SMTP_FROM=secretaria@4andar.com.br

# Chave PIX Padrão da Escola
CHAVE_PIX=pix@4andar.com.br

# =========================================================
# GOOGLE CALENDAR API (OAuth 2.0)
# =========================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
