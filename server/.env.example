# 4ANDAR API Server — Configuração de Ambiente Independente
PORT=3001

# Configuração de E-mail SMTP Próprio (Ex.: Gmail, Sendgrid, Amazon SES, Mailgun, ou servidor SMTP próprio)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=sua-escola@4andar.com.br
SMTP_PASS=sua-senha-de-app-ou-token
SMTP_FROM=secretaria@4andar.com.br

# Chave PIX Padrão da Escola
CHAVE_PIX=pix@4andar.com.br

# Configuração do Google Calendar API (OAuth 2.0 padrão da Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
